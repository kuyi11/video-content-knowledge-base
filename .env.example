# Local data paths. Keep real transcripts and indexes outside Git.
VAULT_DIR=./local-data/vault/videos
OBSIDIAN_EXTERNAL_VAULTS=
INDEX_DIR=./local-data/index

# Model paths and local inference service.
TOOL_DIR=./models
BGE_MODEL_PATH=./models/bge-m3
WHISPER_MODEL_PATH=./models/faster-whisper-medium
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Set a random value to require Authorization: Bearer <token> on API requests.
API_TOKEN=
QUERY_LOGGING_ENABLED=false

# Optional runtime choices.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
SUMMARY_PROFILES=default
