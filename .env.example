# Local data paths. Keep real transcripts and indexes outside Git.
VAULT_DIR=./local-data/vault/videos
OBSIDIAN_EXTERNAL_VAULTS=
INDEX_DIR=./local-data/index
INDEX_HOST_PATH=./local-data/index

# Model paths and local inference service.
TOOL_DIR=./models
BGE_MODEL_PATH=./models/bge-m3
WHISPER_MODEL_PATH=./models/faster-whisper-medium
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=180
RERANKER_MODEL_PATH=
RERANKER_CANDIDATE_K=20
RERANKER_DEVICE=
QUERY_PLANNER_ENABLED=false
QUERY_PLANNER_MODEL=qwen2.5:7b
QUERY_PLANNER_MAX_SUBQUERIES=3
QUERY_MULTI_HOP_ENABLED=false
QUERY_MULTI_HOP_MAX_HOPS=2
SEMANTIC_GROUNDING_MAX_CLAIMS=8
QUERY_CACHE_ENABLED=true
QUERY_CACHE_SIZE=128
API_RATE_LIMIT_PER_MINUTE=60
API_MAX_CONCURRENT_QUERIES=4
# Optional operational cost estimates (per 1K estimated tokens; 0 for local-only usage)
LLM_INPUT_COST_PER_1K=0
LLM_OUTPUT_COST_PER_1K=0
# Required by Docker Compose. Use a long random value for Authorization: Bearer <token>.
API_TOKEN=
QUERY_LOGGING_ENABLED=false
CLAIM_EVIDENCE_AUDIT_ENABLED=false
# 0 means retain indefinitely. Cleanup remains preview-only unless --apply is used.
CLAIM_EVIDENCE_RETENTION_DAYS=0
ALLOW_REMOTE_LLM=false

# Optional runtime choices.
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
SUMMARY_PROFILES=default
